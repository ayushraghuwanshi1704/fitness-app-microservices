# ==============================================================================
# Fitness App Microservices Environment Configuration
# Copy this file to .env and fill in your passwords/keys.
# The .env file is git-ignored and must never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Keycloak Admin Credentials (Port 8181)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 2. PostgreSQL (Keycloak Backend Database - Port 5432)
# ------------------------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# 3. RabbitMQ (Ports 5672, 15672)
# ------------------------------------------------------------------------------
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 4. Local MySQL Server (User Service - Port 3306)
# Ensure database 'fitness_user_db_new' exists with user 'fitness_app'
# ------------------------------------------------------------------------------
USER_DB_URL=jdbc:mysql://localhost:3306/fitness_user_db_new
USER_DB_USERNAME=fitness_app
USER_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Local MongoDB Server (Activity & AI Services - Port 27017)
# ------------------------------------------------------------------------------
ACTIVITY_MONGODB_URI=mongodb://localhost:27017/fitnessactivity
AI_MONGODB_URI=mongodb://localhost:27017/fitnessrecommendation

# ------------------------------------------------------------------------------
# 6. AI Service (Groq / Gemini API)
# ------------------------------------------------------------------------------
# Groq:
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b

# Or Gemini (via OpenAI-compatible endpoint):
# GROQ_API_KEY=<your-gemini-api-key>
# GROQ_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# GROQ_MODEL=gemini-1.5-flash
